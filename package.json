{
  "name": "@mark9804/blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vitepress dev docs --host",
    "build": "vitepress build docs",
    "serve": "vitepress serve docs",
    "preview": "pnpm build && vitepress preview docs",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,js,vue}": [
      "prettier --config .prettierrc.json --write",
      "git add"
    ],
    "*.md": [
      "prettier --config .prettierrc.json --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-mathjax3": "4.3.2",
    "oxlint": "^1.57.0",
    "postcss-plugin-px2rem": "0.8.1",
    "prettier": "3.10.1",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "unocss": "66.12.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vite-plugin-vue-devtools": "8.1.1",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-sidebar": "1.41.0",
    "vue": "3.5.45"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@vercel/speed-insights",
      "esbuild",
      "sharp",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@lucide/vue": "^1.66.0",
    "@mdit/plugin-img-size": "1.3.0",
    "@mdit/plugin-mark": "2.2.0",
    "@mdit/plugin-ruby": "1.2.0",
    "@mdit/plugin-spoiler": "2.2.0",
    "@mdit/plugin-sub": "1.2.0",
    "@mdit/plugin-sup": "1.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/components": "12.5.0",
    "@vueuse/core": "12.5.0",
    "date-fns": "^4.1.0",
    "entities": "^9.0.0",
    "markdown-it-implicit-figures": "0.12.0",
    "pinia": "4.1.0",
    "radashi": "^13.0.0",
    "reka-ui": "^2.9.3",
    "vitepress-plugin-rss": "0.4.6",
    "vue-sonner": "^2.0.9",
    "words-count": "2.0.2"
  }
}
